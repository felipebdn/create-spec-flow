{
  "name": "specflow",
  "version": "0.1.0",
  "description": "Spec-driven development for coding agents, in one command. A queue of specified changes, a readiness gate before any file is written, size ceilings on what gets re-read every session, and guarantees proven by sabotage. pt-BR and English.",
  "keywords": [
    "spec-driven-development",
    "sdd",
    "claude-code",
    "agent",
    "scaffold",
    "specification"
  ],
  "license": "MIT",
  "author": "Felipe Barbosa (https://github.com/felipebdn)",
  "homepage": "https://github.com/felipebdn/specflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipebdn/specflow.git"
  },
  "bugs": {
    "url": "https://github.com/felipebdn/specflow/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "specflow": "bin/specflow.js"
  },
  "exports": {
    ".": "./src/init.js"
  },
  "files": [
    "bin",
    "src",
    "template"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "pack:check": "npm pack --dry-run",
    "i18n:sync": "node scripts/parity-lock.js"
  }
}
